{
  "info": {
    "name": "Laboratorio 02 - Kiara Paola Alburqueque Arzapalo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden con los tres servicios iniciados. Elimina al final únicamente los registros creados en esta ejecución."
  },
  "variable": [
    {
      "key": "estudianteUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "cursoUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "matriculaUrl",
      "value": "http://localhost:8083"
    }
  ],
  "item": [
    {
      "name": "Crear estudiante",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{estudianteUrl}}/api/estudiantes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigo\": \"EST-{{$timestamp}}\",\n  \"nombres\": \"Kiara Paola\",\n  \"apellidos\": \"Alburqueque Arzapalo\",\n  \"correo\": \"kiara@example.com\",\n  \"estado\": \"ACTIVO\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"idEstudiante\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
