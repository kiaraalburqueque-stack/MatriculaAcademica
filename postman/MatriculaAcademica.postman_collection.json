            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Matrícula registrada\", () => pm.expect(pm.response.json().some(x => x.id === Number(pm.collectionVariables.get(\"idMatricula\")))).to.be.true);"
            ]
          }
        }
